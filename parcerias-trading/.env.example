# ============================================================================
# Digital Lens — Parcerias (plataformas de negociação financeira)
#
# Projeto Vercel independente do site principal — não partilha domínio nem
# verificação da Paddle. Reutiliza a mesma base Neon e a mesma conta Resend.
# ============================================================================

# Mesma ligação Neon do site principal — grava só na tabela
# trading_partnership_applications.
DATABASE_URL="postgresql://utilizador:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Mesma chave Resend do site principal.
RESEND_API_KEY="re_..."
EMAIL_FROM="Digital Lens <geral@digitallens.ao>"
# Caixa que recebe notificações de novas candidaturas.
EMAIL_TO="geral@digitallens.ao"

# Palavra-passe do painel /admin (Basic Auth, ver middleware.ts). Escolher uma
# password forte só para este uso — o utilizador do Basic Auth é ignorado,
# só a password é validada.
ADMIN_PASSWORD=""
