# ============================================================================
# Digital Lens — variáveis de ambiente
#
# Copiar para `.env.local` (desenvolvimento) e configurar as mesmas chaves no
# painel da Vercel (Settings → Environment Variables) para produção.
#
# O site arranca sem nenhuma destas variáveis: as páginas institucionais e a
# vitrine funcionam sempre. Cada bloco abaixo activa uma funcionalidade.
# ============================================================================

# ── Base ────────────────────────────────────────────────────────────────────
# Domínio canónico, sem barra final. Alimenta metadata, sitemap, robots.txt,
# JSON-LD e o URL de sucesso do checkout.
NEXT_PUBLIC_SITE_URL="https://digitallens.vercel.app"

# ── Base de dados (Neon / PostgreSQL) ───────────────────────────────────────
# Activa: contas de cliente, histórico de encomendas, registo de contactos e o
# rate limiting persistido (sem ela, o limitador cai para memória — só serve
# para desenvolvimento local, não protege em produção).
# Obter em https://console.neon.tech → Connection string (pooled).
# Aplicar o esquema uma vez:  psql "$DATABASE_URL" -f src/lib/db/schema.sql
DATABASE_URL="postgresql://utilizador:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Autenticação (NextAuth v5 / Auth.js) ────────────────────────────────────
# Activa: /entrar, /registar, /conta. Requer também DATABASE_URL.
# Gerar o segredo com:  npx auth secret     (ou:  openssl rand -base64 32)
AUTH_SECRET=""
# Só necessário fora da Vercel; lá o host é detectado automaticamente.
# AUTH_URL="https://digitallens.vercel.app"

# ── Pagamentos (Paddle) ──────────────────────────────────────────────────────
# Activa: checkout da loja. A Paddle é "merchant of record" — cobra o cliente
# em nosso nome e trata do IVA/impostos globais, o que dispensa registo fiscal
# em cada país onde vendemos.
#
# Chaves em Paddle → Developer Tools → Authentication:
#   PADDLE_API_KEY               chave API (secreta, nunca expor no cliente)
#   NEXT_PUBLIC_PADDLE_CLIENT_TOKEN   client-side token (pública, para o Paddle.js no browser)
PADDLE_API_KEY="pdl_sdbx_apikey_..."
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_..."
# "production" liga à conta real; qualquer outro valor (ou a ausência desta
# variável) usa o sandbox. Definir os dois — servidor e cliente — em conjunto.
PADDLE_ENV="sandbox"
NEXT_PUBLIC_PADDLE_ENV="sandbox"
# Segredo do webhook. Criar o destino em Developer Tools → Notifications
# apontando para https://<dominio>/api/paddle/webhook com os eventos:
#   transaction.paid
#   transaction.completed
#   transaction.payment_failed
#   transaction.canceled
PADDLE_WEBHOOK_SECRET="pdl_ntfset_..."

# ── Blog (Sanity) ────────────────────────────────────────────────────────────
# Activa: /blog e o CMS visual em /studio. Sem estas variáveis, o site usa por
# omissão o projecto "Digital Lens" já criado (e1yra593, dataset "production")
# — só é preciso mudar isto para apontar a outro projecto Sanity.
# São identificadores públicos, não segredos: aparecem no HTML da página.
NEXT_PUBLIC_SANITY_PROJECT_ID="e1yra593"
NEXT_PUBLIC_SANITY_DATASET="production"

# ── E-mail (Resend) ─────────────────────────────────────────────────────────
# Activa: formulário de contacto, boas-vindas, recibos de encomenda.
# Chave em https://resend.com/api-keys
RESEND_API_KEY="re_..."
# Remetente — o domínio tem de estar verificado no Resend.
EMAIL_FROM="Digital Lens <geral@digitallens.ao>"
# Caixa que recebe as notificações internas (contactos e novas encomendas).
EMAIL_TO="geral@digitallens.ao"
